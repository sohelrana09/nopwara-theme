{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:5080/",
        "http://localhost:5080/notebooks",
        "http://localhost:5080/apple-macbook-pro",
        "http://localhost:5080/search?q=apple"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": [
          "performance"
        ],
        "emulatedUserAgent": "Mozilla/5.0 (Linux; Android 14; Pixel 8) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Mobile Safari/537.36",
        "chromeFlags": "--headless=new --no-sandbox",
        "blockedUrlPatterns": [
          "*googletagmanager.com*",
          "*google-analytics.com*"
        ]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1,
                "aggregationMethod": "median"
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 300,
                "aggregationMethod": "median"
              }
            ],
            "dom-size": [
              "error",
              {
                "maxNumericValue": 1500
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 163840
              }
            ],
            "resource-summary:stylesheet:size": [
              "error",
              {
                "maxNumericValue": 40960
              }
            ],
            "resource-summary:document:size": [
              "error",
              {
                "maxNumericValue": 61440
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:5080/$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.85,
                "aggregationMethod": "median"
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 4500,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:5080/.+",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 4000,
                "aggregationMethod": "median"
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
