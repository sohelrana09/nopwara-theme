{
  "name": "nopwara-theme",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Build tooling for the Nopwara nopCommerce theme (Tailwind CSS + Alpine.js)",
  "scripts": {
    "copy:alpine": "node -e \"require('fs').copyFileSync('node_modules/alpinejs/dist/cdn.min.js','../Content/js/alpine.min.js')\"",
    "build:css": "tailwindcss -i app.css -o ../Content/css/styles.min.css --minify",
    "build": "npm run copy:alpine && npm run build:css",
    "watch": "tailwindcss -i app.css -o ../Content/css/styles.min.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "alpinejs": "^3.17.5"
  }
}
