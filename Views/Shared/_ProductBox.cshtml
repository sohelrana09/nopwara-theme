@model ProductOverviewModel

@using Nop.Core
@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Orders
@using Nop.Core.Domain.Tax

@inject CatalogSettings catalogSettings
@inject IWorkContext workContext

@*
    Nopwara product box. Works in grid and list mode: list-mode styles use the in-[.product-list] variant,
    because core wraps list results in .product-list. Buttons still call the core AjaxCart (jQuery) functions.
*@
@{
    //prepare "Add to cart" AJAX link
    var shoppingCartTypeId = (int)ShoppingCartType.ShoppingCart;
    var quantity = 1;
    var addtocartlink = Model.ProductPrice.ForceRedirectionAfterAddingToCart
        ? Url.RouteUrl(NopRouteNames.Ajax.ADD_PRODUCT_TO_CART_CATALOG, new { productId = Model.Id, shoppingCartTypeId, quantity, forceredirection = Model.ProductPrice.ForceRedirectionAfterAddingToCart })
        : Url.RouteUrl(NopRouteNames.Ajax.ADD_PRODUCT_TO_CART_CATALOG, new { productId = Model.Id, shoppingCartTypeId, quantity });

    var addtowishlistlink = Url.RouteUrl(NopRouteNames.Ajax.ADD_PRODUCT_TO_CART_CATALOG, new { productId = Model.Id, shoppingCartTypeId = (int)ShoppingCartType.Wishlist, quantity });
    var addtocomparelink = Url.RouteUrl(NopRouteNames.Ajax.ADD_PRODUCT_TO_COMPARE, new { productId = Model.Id });
    var productUrl = await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = Model.SeName });

    const string iconButtonCss = "inline-flex size-8 items-center justify-center rounded-full border border-slate-200 bg-white/90 text-slate-500 shadow-sm backdrop-blur hover:text-primary-600";
}
<article class="product-item group/card flex h-full flex-col overflow-hidden rounded-lg border border-slate-200 bg-white transition-shadow hover:shadow-md in-[.product-list]:flex-row" data-productid="@Model.Id">
    <div class="picture relative bg-white in-[.product-list]:w-36 in-[.product-list]:shrink-0 sm:in-[.product-list]:w-56">
        @if (Model.PictureModels.Count > 1)
        {
            <div class="swiper aspect-square" id="swiper-@Model.Id" dir="@Html.GetUIDirection(!await Html.ShouldUseRtlThemeAsync())">
                <div class="swiper-wrapper">
                    @foreach (var picture in Model.PictureModels)
                    {
                        <a class="swiper-slide flex items-center justify-center p-4" href="@productUrl" title="@picture.Title">
                            <img alt="@picture.AlternateText" src="@picture.ImageUrl" title="@picture.Title" loading="lazy" class="max-h-full max-w-full object-contain" />
                        </a>
                    }
                </div>
                <div class="swiper-pagination"></div>
            </div>

            <script asp-location="Footer">
                new Swiper('#swiper-@(Model.Id)', {
                    pagination: {
                        clickable: true,
                        el: '.swiper-pagination',
                    },
                });
            </script>
        }
        else
        {
            var picture = Model.PictureModels.FirstOrDefault();
            <a href="@productUrl" title="@picture?.Title" class="flex aspect-square items-center justify-center p-4">
                <img alt="@picture?.AlternateText" src="@picture?.ImageUrl" title="@picture?.Title" loading="lazy" class="max-h-full max-w-full object-contain transition-transform duration-300 group-hover/card:scale-105" />
            </a>
        }

        @*secondary actions float over the picture so "Add to cart" keeps the full card width*@
        <div class="absolute right-2 top-2 z-10 flex flex-col gap-1.5">
            @*Nopwara widget zone for extra card actions (e.g. the Nopwara quick view button)*@
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = "nopwara_productbox_actions", additionalData = Model })
            @if (!Model.ProductPrice.DisableWishlistButton)
            {
                @await Html.PartialAsync("_MoveToWishlistModal", Model.ProductToWishlist)

                <button type="button" class="add-to-wishlist-button @iconButtonCss" title="@T("ShoppingCart.AddToWishlist")" onclick="AjaxCart.addproducttocart_catalog('@addtowishlistlink');return false;">
                    <span class="sr-only">@T("ShoppingCart.AddToWishlist")</span>
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" /></svg>
                </button>
            }
            @if (!Model.ProductPrice.DisableAddToCompareListButton)
            {
                <button type="button" class="add-to-compare-list-button @iconButtonCss" title="@T("ShoppingCart.AddToCompareList")" onclick="AjaxCart.addproducttocomparelist('@addtocomparelink');return false;">
                    <span class="sr-only">@T("ShoppingCart.AddToCompareList")</span>
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" /></svg>
                </button>
            }
        </div>
    </div>

    <div class="details flex flex-1 flex-col gap-2 border-t border-slate-100 p-4 in-[.product-list]:border-l in-[.product-list]:border-t-0">
        <h2 class="product-title text-sm font-medium leading-snug">
            <a href="@productUrl" class="line-clamp-2 text-slate-900 hover:text-primary-600">@Model.Name</a>
        </h2>
        @if (catalogSettings.ShowSkuOnCatalogPages && !string.IsNullOrEmpty(Model.Sku))
        {
            <div class="sku text-xs text-slate-500">@Model.Sku</div>
        }
        @if (Model.ReviewOverviewModel.AllowCustomerReviews)
        {
            var ratingPercent = 0;
            if (Model.ReviewOverviewModel.TotalReviews != 0)
            {
                ratingPercent = ((Model.ReviewOverviewModel.RatingSum * 100) / Model.ReviewOverviewModel.TotalReviews) / 5;
            }
            <div class="product-rating-box flex items-center gap-1.5 text-xs text-slate-500" title="@string.Format(T("Reviews.TotalReviews").Text, Model.ReviewOverviewModel.TotalReviews)">
                <div class="rating relative inline-block leading-none tracking-wider text-slate-300" aria-hidden="true">
                    ★★★★★
                    <div class="absolute inset-y-0 left-0 overflow-hidden whitespace-nowrap text-amber-400" style="width: @(ratingPercent)%">★★★★★</div>
                </div>
                <span class="sr-only">@string.Format(T("Reviews.TotalReviews").Text, Model.ReviewOverviewModel.TotalReviews)</span>
            </div>
        }
        @if (catalogSettings.ShowShortDescriptionOnCatalogPages)
        {
            <div class="description hidden text-sm text-slate-600 in-[.product-list]:block">
                @Html.Raw(Model.ShortDescription)
            </div>
        }

        <div class="add-info mt-auto space-y-3 pt-2">
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductBoxAddinfoBefore, additionalData = Model })
            <div class="prices flex flex-wrap items-baseline gap-x-2">
                @if (!string.IsNullOrEmpty(Model.ProductPrice.OldPrice))
                {
                    <span class="price old-price text-sm text-slate-400 line-through">@Model.ProductPrice.OldPrice</span>
                }
                <span class="price actual-price text-base font-bold text-slate-900">@Model.ProductPrice.Price</span>
                @if (Model.ProductPrice.DisplayTaxShippingInfo)
                {
                    var inclTax = await workContext.GetTaxDisplayTypeAsync() == TaxDisplayType.IncludingTax;
                    //tax info is already included in the price (incl/excl tax). that's why we display only shipping info here
                    <span class="tax-shipping-info w-full text-xs text-slate-500">
                        @T(inclTax ? "Products.Price.TaxShipping.InclTax" : "Products.Price.TaxShipping.ExclTax", await NopUrl.RouteTopicUrlAsync("shippinginfo"))
                    </span>
                }
                @if (!string.IsNullOrEmpty(Model.ProductPrice.BasePricePAngV))
                {
                    <div class="base-price-pangv w-full text-xs text-slate-500">@Model.ProductPrice.BasePricePAngV</div>
                }
            </div>
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductBoxAddinfoMiddle, additionalData = Model })
            <div class="buttons flex items-center gap-2">
                @if (!Model.ProductPrice.DisableBuyButton)
                {
                    var addToCartText = T("ShoppingCart.AddToCart").Text;
                    if (Model.ProductPrice.IsRental)
                    {
                        addToCartText = T("ShoppingCart.Rent").Text;
                    }
                    if (Model.ProductPrice.AvailableForPreOrder)
                    {
                        addToCartText = T("ShoppingCart.PreOrder").Text;
                    }
                    <button type="button" class="product-box-add-to-cart-button btn btn-primary w-full px-3 in-[.product-list]:w-auto" onclick="AjaxCart.addproducttocart_catalog('@addtocartlink');return false;">
                        <svg class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007Z" /></svg>
                        <span class="truncate">@addToCartText</span>
                    </button>
                }
            </div>
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductBoxAddinfoAfter, additionalData = Model })
        </div>
    </div>
</article>
