@*
    Nopwara trust strip (home page): store promises taken from the store's own settings, so it never claims something the store
    doesn't do. Free delivery only with "free shipping over X" on, returns only with return requests on; secure checkout and
    customer support always. Hide it with the setting nopwarathemesettings.showtruststrip = false.
    Texts are resources with English fallbacks (Nopwara.TrustStrip.*).
*@
@using Nop.Core.Domain.Orders
@using Nop.Core.Domain.Shipping
@inject ShippingSettings shippingSettings
@*nopCommerce 5.00: return request settings moved from OrderSettings to ReturnRequestSettings*@
@inject ReturnRequestSettings returnRequestSettings
@inject Nop.Services.Configuration.ISettingService settingService
@inject Nop.Core.IStoreContext storeContext
@inject Nop.Services.Directory.ICurrencyService currencyService
@inject Nop.Services.Catalog.IPriceFormatter priceFormatter
@{
    var show = await settingService.GetSettingByKeyAsync("nopwarathemesettings.showtruststrip", true, (await storeContext.GetCurrentStoreAsync()).Id, loadSharedValueIfNotFound: true);
    var languageId = (await NopwaraWorkContext.GetWorkingLanguageAsync()).Id;
    async Task<string> Text(string key, string fallback) => await NopwaraLocalization.GetResourceAsync(key, languageId, logIfNotFound: false, defaultValue: fallback);

    var items = new List<(string Icon, string Title, string Note, string Url)>();
    if (show)
    {
        if (shippingSettings.FreeShippingOverXEnabled)
        {
            var amount = await currencyService.ConvertFromPrimaryStoreCurrencyAsync(shippingSettings.FreeShippingOverXValue, await NopwaraWorkContext.GetWorkingCurrencyAsync());
            items.Add(("M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12",
                await Text("Nopwara.TrustStrip.FreeDelivery", "Free delivery"),
                string.Format(await Text("Nopwara.TrustStrip.FreeDelivery.Note", "On orders over {0}"), await priceFormatter.FormatPriceAsync(amount)),
                null));
        }
        if (returnRequestSettings.ReturnRequestsEnabled)
        {
            items.Add(("M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3",
                returnRequestSettings.NumberOfDaysReturnRequestAvailable > 0
                    ? string.Format(await Text("Nopwara.TrustStrip.Returns.Days", "{0}-day returns"), returnRequestSettings.NumberOfDaysReturnRequestAvailable)
                    : await Text("Nopwara.TrustStrip.Returns", "Easy returns"),
                await Text("Nopwara.TrustStrip.Returns.Note", "Request a return from your account"),
                null));
        }
        items.Add(("M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z",
            await Text("Nopwara.TrustStrip.Secure", "Secure checkout"),
            await Text("Nopwara.TrustStrip.Secure.Note", "Your payment details are protected"),
            null));
        items.Add(("M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155",
            await Text("Nopwara.TrustStrip.Support", "Customer support"),
            await Text("Nopwara.TrustStrip.Support.Note", "Questions? Contact us"),
            Url.RouteUrl(NopRouteNames.General.CONTACT_US)));
    }
}
@if (items.Count > 0)
{
    //full class names, so Tailwind finds them
    var columns = items.Count switch { 4 => "lg:grid-cols-4", 3 => "lg:grid-cols-3", _ => "lg:grid-cols-2" };
    <ul class="trust-strip grid grid-cols-2 gap-3 @columns">
        @foreach (var item in items)
        {
            var content = new Microsoft.AspNetCore.Html.HtmlString(
                $"<svg class=\"size-6 shrink-0 text-primary-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"{item.Icon}\" /></svg>"
                + $"<span class=\"min-w-0\"><span class=\"block text-sm font-semibold text-slate-900\">{System.Net.WebUtility.HtmlEncode(item.Title)}</span><span class=\"block text-xs text-slate-500\">{System.Net.WebUtility.HtmlEncode(item.Note)}</span></span>");
            <li>
                @if (item.Url != null)
                {
                    <a href="@item.Url" class="flex h-full items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 transition hover:border-primary-200 hover:bg-primary-50/40">@content</a>
                }
                else
                {
                    <div class="flex h-full items-center gap-3 rounded-xl border border-slate-200 bg-white p-4">@content</div>
                }
            </li>
        }
    </ul>
}
