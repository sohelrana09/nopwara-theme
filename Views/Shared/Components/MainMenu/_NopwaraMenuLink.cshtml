@model MenuItemModel

@*Level 0 = top bar item, 1+ = dropdown item. Items without a URL render as plain text.*@
@{
    var level = ViewData["Level"] as int? ?? 0;
    var css = level == 0
        ? "block rounded-md px-2 py-2 text-sm font-semibold text-slate-800 transition-colors hover:text-primary-600 lg:px-3 lg:group-hover:text-primary-600"
        : "block rounded-md px-2 py-1.5 text-sm text-slate-600 transition-colors hover:bg-slate-50 hover:text-primary-600";
}
@if (string.IsNullOrEmpty(Model.Url))
{
    <span role="menuitem" class="menu__link menu__link--inactive @css cursor-default hover:bg-transparent hover:text-inherit">@Model.Title</span>
}
else
{
    <a href="@Model.Url" role="menuitem" class="menu__link @css">@Model.Title</a>
}
