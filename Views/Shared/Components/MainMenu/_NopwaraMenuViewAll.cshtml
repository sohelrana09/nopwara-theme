@model Dictionary<string, string>

@*"View all" link at the end of a dropdown (mega menu extras: viewAllText, viewAllUrl)*@
<a href="@Model["viewAllUrl"]" role="menuitem" class="menu__view-all mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary-700 hover:text-primary-600">
    @Model["viewAllText"]
    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
</a>
