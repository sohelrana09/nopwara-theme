@model MenuItemModel

@*
    One mobile menu level: Back + title, "View all", the item's children (those with children of their own open the next
    level), then the mega menu promo (widget zone nopwara_megamenu_panel_mobile). Child levels are rendered right after
    this one as siblings, so every level slides inside the same container.
*@
@{
    var panelId = (string)ViewData["PanelId"];
    var depth = ViewData["Depth"] as int? ?? 1;
    var megaMenu = ViewData["MegaMenu"] as Dictionary<string, Dictionary<string, string>>;
    //keys: "i{menuItemId}", or "c{categoryId}" for category items core generates (no menu item id)
    Dictionary<string, string> ExtrasOf(MenuItemModel item)
    {
        var key = item.Id > 0 ? $"i{item.Id}" : item.MenuItemType == Nop.Core.Domain.Menus.MenuItemType.Category ? $"c{item.EntityId}" : null;
        return key != null && megaMenu != null && megaMenu.TryGetValue(key, out var extras) ? extras : null;
    }
    var ownExtras = ExtrasOf(Model);
    //"View all": the plugin's link, or the item's own page when it has one
    var viewAllUrl = ownExtras?.GetValueOrDefault("viewAllUrl") ?? Model.Url;
    var viewAllText = ownExtras?.GetValueOrDefault("viewAllText")
        ?? string.Format(await NopwaraLocalization.GetResourceAsync("Nopwara.Menu.ViewAll", (await NopwaraWorkContext.GetWorkingLanguageAsync()).Id,
            logIfNotFound: false, defaultValue: "View all {0}"), Model.Title);
}
<div class="absolute inset-0 overflow-y-auto bg-white transition duration-300 ease-out" x-cloak
     data-panel="@panelId" role="menu" aria-label="@Model.Title"
     :class="panelClass('@panelId')"
     :inert="!isTop('@panelId')">
    <div class="sticky top-0 z-10 flex items-center gap-2 border-b border-slate-200 bg-white px-2 py-2">
        <button type="button" class="flex items-center gap-1 rounded-md px-2 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100" @@click="back()">
            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
            @T("Common.Back")
        </button>
        <span class="truncate text-base font-semibold text-slate-900">@Model.Title</span>
    </div>

    @if (!string.IsNullOrEmpty(viewAllUrl))
    {
        <a href="@viewAllUrl" role="menuitem" class="flex items-center justify-between px-4 py-3.5 text-sm font-semibold text-primary-700 hover:bg-slate-50">
            @viewAllText
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
    }

    <ul class="divide-y divide-slate-100 border-t border-slate-100">
        @for (var i = 0; i < Model.ChildrenItems.Count; i++)
        {
            var child = Model.ChildrenItems[i];
            var linkData = new ViewDataDictionary(ViewData) { ["Extras"] = ExtrasOf(child) };
            <li role="none" class="@child.CssClass">
                @if (child.ChildrenItems.Any())
                {
                    <button type="button" role="menuitem" aria-haspopup="menu" class="flex w-full items-center gap-3 px-4 py-3 text-left text-sm font-medium text-slate-800 hover:bg-slate-50"
                            @@click="open('@(panelId)-@(i)', $el)">
                        @if (child.Picture is not null)
                        {
                            <img src="@child.Picture.ImageUrl" alt="@child.Picture.AlternateText" class="size-9 shrink-0 rounded object-contain" loading="lazy" />
                        }
                        <span class="flex min-w-0 items-center gap-1.5">@await Html.PartialAsync("_NopwaraMenuLabel.cshtml", child, linkData)</span>
                        <svg class="ml-auto size-5 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
                    </button>
                }
                else
                {
                    <a href="@(string.IsNullOrEmpty(child.Url) ? null : child.Url)" role="menuitem" class="flex items-center gap-3 px-4 py-3 text-sm text-slate-700 hover:bg-slate-50">
                        @if (child.Picture is not null)
                        {
                            <img src="@child.Picture.ImageUrl" alt="@child.Picture.AlternateText" class="size-9 shrink-0 rounded object-contain" loading="lazy" />
                        }
                        <span class="flex min-w-0 items-center gap-1.5">@await Html.PartialAsync("_NopwaraMenuLabel.cshtml", child, linkData)</span>
                    </a>
                }
            </li>
        }
    </ul>

    @if (depth == 1)
    {
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = "nopwara_megamenu_panel_mobile", additionalData = Model })
    }
</div>

@for (var i = 0; i < Model.ChildrenItems.Count; i++)
{
    var child = Model.ChildrenItems[i];
    if (child.ChildrenItems.Any())
    {
        @await Html.PartialAsync("_NopwaraMobilePanel.cshtml", child, new ViewDataDictionary(ViewData) { ["PanelId"] = $"{panelId}-{i}", ["Depth"] = depth + 1 })
    }
}
