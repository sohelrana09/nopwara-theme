@model IList<MenuItemModel>

@*Nested list used inside list-template dropdowns; deeper levels are indented, not flown out*@
@{
    var level = ViewData["Level"] as int? ?? 1;
}
<ul role="menu" class="space-y-0.5">
    @foreach (var item in Model)
    {
        <li role="none" class="@item.CssClass">
            @await Html.PartialAsync("_NopwaraMenuLink.cshtml", item, new ViewDataDictionary(ViewData) { ["Level"] = level })
            @if (item.ChildrenItems.Any())
            {
                <div class="pl-3">
                    @await Html.PartialAsync("_NopwaraMenuList.cshtml", item.ChildrenItems, new ViewDataDictionary(ViewData) { ["Level"] = level + 1 })
                </div>
            }
        </li>
    }
</ul>
