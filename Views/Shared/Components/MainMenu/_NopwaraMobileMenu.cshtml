@model MenuModel

@*
    Mobile main menu (< lg, inside the header drawer): slide-in levels.
    The root level lists the top items; each item with children opens its own panel (rendered as siblings by
    _NopwaraMobilePanel), which slides in from the right with a Back button. Alpine component: nopwaraMobileMenu (nopwara.js).
*@
@{
    var megaMenu = ViewData["MegaMenu"] as Dictionary<string, Dictionary<string, string>>;
    //keys: "i{menuItemId}", or "c{categoryId}" for category items core generates (no menu item id)
    Dictionary<string, string> ExtrasOf(MenuItemModel item)
    {
        var key = item.Id > 0 ? $"i{item.Id}" : item.MenuItemType == Nop.Core.Domain.Menus.MenuItemType.Category ? $"c{item.EntityId}" : null;
        return key != null && megaMenu != null && megaMenu.TryGetValue(key, out var extras) ? extras : null;
    }
}
<div class="nopwara-mobile-menu relative h-full overflow-hidden lg:hidden" x-data="nopwaraMobileMenu()">
    <div class="absolute inset-0 overflow-y-auto transition duration-300 ease-out"
         :class="stack.length ? '-translate-x-1/4 opacity-0' : 'translate-x-0 opacity-100'"
         :inert="stack.length > 0">
        <ul role="menu" class="divide-y divide-slate-100 py-1">
            @for (var i = 0; i < Model.Items.Count; i++)
            {
                var item = Model.Items[i];
                var panelId = $"m{i}";
                var linkData = new ViewDataDictionary(ViewData) { ["Extras"] = ExtrasOf(item) };
                <li role="none" class="@item.CssClass">
                    @if (item.ChildrenItems.Any())
                    {
                        <button type="button" role="menuitem" aria-haspopup="menu" class="flex w-full items-center gap-1.5 px-4 py-3.5 text-left text-base font-semibold text-slate-800 hover:bg-slate-50"
                                @@click="open('@panelId', $el)">
                            @await Html.PartialAsync("_NopwaraMenuLabel.cshtml", item, linkData)
                            <svg class="ml-auto size-5 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
                        </button>
                    }
                    else if (string.IsNullOrEmpty(item.Url))
                    {
                        <span role="menuitem" class="flex items-center gap-1.5 px-4 py-3.5 text-base font-semibold text-slate-500">
                            @await Html.PartialAsync("_NopwaraMenuLabel.cshtml", item, linkData)
                        </span>
                    }
                    else
                    {
                        <a href="@item.Url" role="menuitem" class="flex items-center gap-1.5 px-4 py-3.5 text-base font-semibold text-slate-800 hover:bg-slate-50">
                            @await Html.PartialAsync("_NopwaraMenuLabel.cshtml", item, linkData)
                        </a>
                    }
                </li>
            }
        </ul>
    </div>

    @for (var i = 0; i < Model.Items.Count; i++)
    {
        var item = Model.Items[i];
        if (item.ChildrenItems.Any())
        {
            @await Html.PartialAsync("_NopwaraMobilePanel.cshtml", item, new ViewDataDictionary(ViewData) { ["PanelId"] = $"m{i}", ["MegaMenu"] = megaMenu, ["Depth"] = 1 })
        }
    }
</div>
