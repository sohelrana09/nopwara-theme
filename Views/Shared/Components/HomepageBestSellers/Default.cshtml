@model IList<ProductOverviewModel>
@*Nopwara: grid columns come from .product-grid .item-grid in tailwind/app.css*@
@if (Model.Count > 0)
{
    <section class="product-grid bestsellers space-y-5">
        <h2 class="title text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">
            @T("Bestsellers")
        </h2>
        <div class="item-grid">
            @foreach (var item in Model)
            {
                <div class="item-box">
                    @await Html.PartialAsync("_ProductBox", item)
                </div>
            }
        </div>
    </section>
}
