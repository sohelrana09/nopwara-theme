@model IList<ProductOverviewModel>
@*Nopwara: shown as a carousel (Views/Shared/_NopwaraProductCarousel.cshtml)*@
@{
    ViewData["NopwaraCarouselTitle"] = T("Homepage.Products").Text;
    ViewData["NopwaraCarouselClass"] = "home-page-product-grid";
}
@await Html.PartialAsync("_NopwaraProductCarousel", Model, ViewData)
