@model SearchBoxModel

@inject Nop.Services.Cms.IWidgetPluginManager widgetPluginManager
@inject Nop.Core.IStoreContext storeContext
@inject Nop.Core.IWorkContext workContext

@{
    const string categoryFormName = "cid";
    const string termFormName = "q";
    const string searchBoxId = "small-searchterms";

    //Nopwara: the Nopwara instant search plugin (Widgets.NopwaraSearch) renders its own dropdown in the "searchbox" widget zone,
    //so the core jQuery UI autocomplete is skipped while that widget is active
    var instantSearchActive = await widgetPluginManager.IsPluginActiveAsync("Widgets.NopwaraSearch",
        await workContext.GetCurrentCustomerAsync(), (await storeContext.GetCurrentStoreAsync()).Id);
}

@{
    var searchBoxConfig = System.Text.Json.JsonSerializer.Serialize(new
    {
        minLength = Model.SearchTermMinimumLength,
        emptyMessage = T("Search.EnterSearchTerms").Text,
        searchUrl = Url.RouteUrl(NopRouteNames.General.SEARCH),
        categories = Model.ShowSearchBoxCategories,
        autocomplete = Model.AutoCompleteEnabled && !instantSearchActive,
        autocompleteUrl = Url.RouteUrl(NopRouteNames.Ajax.PRODUCT_SEARCH_AUTOCOMPLETE),
        showImages = Model.ShowProductImagesInSearchAutoComplete,
        thumbSize = Model.AutoCompleteSearchThumbPictureSize
    });
}

@*Nopwara: ids and names are unchanged from core; submit and the autocomplete fallback are the Alpine component nopwaraSearchBox (Content/js/nopwara.js)*@
<div class="relative w-full" x-data="nopwaraSearchBox(@searchBoxConfig)" @@click.outside="open = false" @@keydown.escape="open = false">
<form asp-route="@NopRouteNames.General.SEARCH" method="get" id="small-search-box-form" x-on:submit.prevent="submit($el)"
      class="flex w-full items-stretch overflow-hidden rounded-lg border border-slate-300 bg-white focus-within:border-primary-500 focus-within:ring-2 focus-within:ring-primary-100">
    @if (Model.ShowSearchBox)
    {
        <input type="text" class="search-box-text min-w-0 flex-1 border-0 bg-transparent px-4 py-2.5 text-sm outline-none placeholder:text-slate-400" id="@searchBoxId" autocomplete="off" name="@termFormName" placeholder="@T("Search.SearchBox.Tooltip")" aria-label="@T("Search.SearchBox.Text.Label")"
               x-ref="term" @@input="query()" @@focus="query()" @@keydown.down.prevent="move(1)" @@keydown.up.prevent="move(-1)" @@keydown.enter="pick($event)" />
        @if(Model.ShowSearchBoxCategories)
        {
            <select asp-for="SearchCategoryId" name="@categoryFormName" asp-items="Model.AvailableCategories" x-ref="category" x-on:change="$refs.term.focus()" class="search-box-category hidden max-w-44 border-0 border-l border-slate-200 bg-slate-50 px-3 text-sm text-slate-600 outline-none sm:block"></select>
        }
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.SearchBoxBeforeSearchButton, additionalData = Model })
        <button type="submit" class="button-1 search-box-button flex items-center gap-2 bg-primary-600 px-4 text-sm font-semibold text-white hover:bg-primary-700">
            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><use href="@(Url.Content("~/Themes/Nopwara/Content/icons.svg"))?v=c9d60074#i-94925d" /></svg>
            <span class="sr-only sm:not-sr-only">@T("Search.Button")</span>
        </button>
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.SearchBox, additionalData = Model })
    }
</form>
@if (Model.ShowSearchBox && Model.AutoCompleteEnabled && !instantSearchActive)
{
    <ul class="ui-autocomplete absolute inset-x-0 top-full z-50 mt-1 max-h-96 overflow-y-auto rounded-lg border border-slate-200 bg-white py-1 shadow-lg" x-show="open" x-cloak role="listbox">
        <template x-for="(item, i) in items" :key="i">
            <li class="search-box-item" role="option" :aria-selected="active === i">
                <a :href="item.producturl" class="search-box-link flex items-center gap-3 px-3 py-2 text-sm text-slate-700 hover:bg-slate-50" :class="active === i && 'bg-slate-50'">
                    <template x-if="showImages"><img :src="item.productpictureurl" :width="thumbSize" alt="" class="shrink-0 object-contain" /></template>
                    <span x-text="item.label"></span>
                </a>
            </li>
        </template>
        <li x-show="showLink" class="border-t border-slate-100"><a :href="searchUrl + '?q=' + encodeURIComponent($refs.term.value)" class="block px-3 py-2 text-sm font-semibold text-primary-700 hover:bg-slate-50">@T("Search.SearchBox.SearchPageLink")</a></li>
    </ul>
}
</div>
