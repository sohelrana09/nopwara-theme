@model CatalogProductsModel

@*Nopwara: markup restyled; ids, data-viewmode attributes and the jQuery handlers (read by CatalogProducts) are unchanged from core*@
@if (Model.Products.Count <= 0 &&
     !Model.PriceRangeFilter.Enabled &&
     !Model.SpecificationFilter.Enabled &&
     !Model.ManufacturerFilter.Enabled)
{
    return;
}

@{
    const string selectCss = "rounded-md border border-slate-300 bg-white py-1.5 pl-2 pr-7 text-sm text-slate-700 focus:border-primary-500 focus:outline-none";
    const string viewModeCss = "viewmode-icon inline-flex size-9 items-center justify-center rounded-md border border-slate-300 text-slate-500 hover:text-slate-900 [&.selected]:border-primary-600 [&.selected]:bg-primary-50 [&.selected]:text-primary-700";
}
<div class="product-selectors flex flex-wrap items-center gap-x-6 gap-y-3 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600">
    @*view mode*@
    @if (Model.AllowProductViewModeChanging)
    {
        <div class="product-viewmode flex items-center gap-2">
            <span>@T("Catalog.ViewMode")</span>
            @if (Model.AvailableViewModes.Count > 1)
            {
                var gridMode = Model.AvailableViewModes[0];
                var listMode = Model.AvailableViewModes[1];

                <a class="@viewModeCss @if (gridMode.Selected){<text>selected</text>}" data-viewmode="@gridMode.Value" title="@gridMode.Text" tabindex="0" role="button" href="#">
                    <span class="sr-only">@gridMode.Text</span>
                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><use href="@(Url.Content("~/Themes/Nopwara/Content/icons.svg"))?v=c9d60074#i-ac3861" /></svg>
                </a>
                <a class="@viewModeCss @if (listMode.Selected){<text>selected</text>}" data-viewmode="@listMode.Value" title="@listMode.Text" tabindex="0" role="button" href="#">
                    <span class="sr-only">@listMode.Text</span>
                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><use href="@(Url.Content("~/Themes/Nopwara/Content/icons.svg"))?v=c9d60074#i-7e65b7" /></svg>
                </a>
            }
        </div>
    }

    @if (Model.AllowProductSorting)
    {
        <div class="product-sorting flex items-center gap-2">
            <label for="products-orderby">@T("Catalog.OrderBy")</label>
            @Html.DropDownList("products-orderby", Model.AvailableSortOptions, new { aria_label = T("Catalog.OrderBy.Label"), @class = selectCss })
        </div>
    }

    @if (Model.AllowCustomersToSelectPageSize)
    {
        <div class="product-page-size flex items-center gap-2 sm:ml-auto">
            <label for="products-pagesize">@T("Catalog.PageSize")</label>
            @Html.DropDownList("products-pagesize", Model.PageSizeOptions, new { aria_label = T("Catalog.PageSize.Label"), @class = selectCss })
            <span>@T("Catalog.PageSize.PerPage")</span>
        </div>
    }
</div>
