@model CatalogProductsModel

@*Nopwara: core markup + a "load more" button (handled by nopwara-catalog.js, ajax loading only); the pager stays for SEO*@
@if (!string.IsNullOrEmpty(Model.WarningMessage))
{
    <div class="warning">
        @Model.WarningMessage
    </div>
}

@if (Model.Products.Count > 0)
{
    <div class="@(Model.ViewMode == "list" ? "product-list" : "product-grid")">
        <div class="item-grid">
            @{ var nopwaraIndex = 0; }
            @foreach (var product in Model.Products)
            {
                <div class="item-box">
                    @await Html.PartialAsync("_ProductBox", product, new ViewDataDictionary(ViewData) { ["NopwaraIndex"] = nopwaraIndex++ })
                </div>
            }
        </div>
    </div>

    @if (Model.UseAjaxLoading && Model.HasNextPage)
    {
        <div class="load-more mt-8 flex justify-center">
            <button type="button" data-load-more="@(Model.PageNumber + 1)"
                    class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-800 shadow-xs transition hover:border-slate-400 hover:bg-slate-50 disabled:cursor-wait disabled:opacity-60">
                <svg class="size-4 animate-spin" data-load-more-spinner hidden fill="none" viewBox="0 0 24 24" aria-hidden="true"><use href="@(Url.Content("~/Themes/Nopwara/Content/icons.svg"))?v=c9d60074#i-98e9cf" /></svg>
                <span data-load-more-label></span>
            </button>
        </div>
    }

    var pager = Html.Pager(Model)
        .QueryParam("pagenumber")
        // for search page
        .BooleanParameterName("advs")
        .BooleanParameterName("isc")
        .BooleanParameterName("sid")
        .RenderEmptyParameters(true);

    @if (!await pager.IsEmpty())
    {
        <div class="pager">
            @pager
        </div>
    }
}
else if (!string.IsNullOrEmpty(Model.NoResultMessage))
{
    <div class="no-result">
        @Model.NoResultMessage
    </div>
}
